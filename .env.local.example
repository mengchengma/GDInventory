# Supabase — get these from your Supabase project: Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-secret-key-here

# Auth gate — shared credential for the team
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me

# A long random string. Generate one with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-64-char-hex-string

# imgbb (optional — enables uploading event photos from inside the app.
# Until this is set, you can still add events by pasting an image URL.)
# Get a free API key at https://api.imgbb.com/ — email confirmation, no credit card.
# IMGBB_API_KEY=

# Staff PIN that releases the customer lock on /members (kiosk mode).
# Any length; digits are easiest on a tablet.
KIOSK_EXIT_PIN=1234
